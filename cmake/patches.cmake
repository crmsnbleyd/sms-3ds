# Copy-then-patch, at configure time (modeled on sms-pc-port's cmake/patches.cmake, MIT; see NOTICE).
#
# sms_apply_patches(<name> SOURCE_ROOT <dir> DEST_ROOT <dir> PATCHES <p>... TOUCHED_VAR <var>)
#
# Every file a patch touches (its "+++ b/<path>" lines) is copied from SOURCE_ROOT into a scratch
# tree the first time it is touched; the patches are applied there in the order given with
# `patch -p1 --force`; changed results are copied into DEST_ROOT (unchanged files keep their mtime,
# so reconfiguring does not force rebuilds), and stale files are removed. SOURCE_ROOT is never
# written: refs/ stays read-only. TOUCHED_VAR receives the touched paths, relative to the roots.
# A stamp listing the patched headers (DEST_ROOT/headers.stamp) changes only when that set changes;
# objects depend on it so a header that becomes patched is picked up.
function(sms_apply_patches name)
  cmake_parse_arguments(A "" "SOURCE_ROOT;DEST_ROOT;TOUCHED_VAR" "PATCHES" ${ARGN})
  set(scratch ${A_DEST_ROOT}.new)
  file(REMOVE_RECURSE ${scratch})
  file(MAKE_DIRECTORY ${scratch} ${A_DEST_ROOT})
  set(touched "")
  list(LENGTH A_PATCHES count)
  set(index 0)
  foreach(p ${A_PATCHES})
    math(EXPR index "${index} + 1")
    math(EXPR step "${index} % 25")
    if(step EQUAL 1 OR index EQUAL count)
      message(STATUS "sms-3ds: applying ${name} patches (${index}/${count})")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${p})
    file(STRINGS ${p} hdrs REGEX "^\\+\\+\\+ b/")
    foreach(h ${hdrs})
      string(REGEX REPLACE "^\\+\\+\\+ b/([^\t ]+).*" "\\1" f "${h}")
      if(NOT EXISTS ${scratch}/${f})
        get_filename_component(d ${scratch}/${f} DIRECTORY)
        file(MAKE_DIRECTORY ${d})
        if(EXISTS ${A_SOURCE_ROOT}/${f})
          file(COPY_FILE ${A_SOURCE_ROOT}/${f} ${scratch}/${f})
        endif()
        list(APPEND touched ${f})
      endif()
    endforeach()
    execute_process(COMMAND patch -p1 --quiet --force -d ${scratch} -i ${p}
                    TIMEOUT 300 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "sms-3ds: ${name} patch failed to apply (${rc}): ${p}\n${out}")
    endif()
  endforeach()

  file(GLOB_RECURSE old RELATIVE ${A_DEST_ROOT} ${A_DEST_ROOT}/*)
  foreach(f ${old})
    if(f STREQUAL "headers.stamp")
      continue()
    endif()
    list(FIND touched ${f} idx)
    if(idx EQUAL -1)
      file(REMOVE ${A_DEST_ROOT}/${f})
    endif()
  endforeach()
  set(headers "")
  foreach(f ${touched})
    get_filename_component(d ${A_DEST_ROOT}/${f} DIRECTORY)
    file(MAKE_DIRECTORY ${d})
    file(COPY_FILE ${scratch}/${f} ${A_DEST_ROOT}/${f} ONLY_IF_DIFFERENT)
    if(f MATCHES "\\.(h|hpp|inc|pch)$")
      list(APPEND headers ${f})
    endif()
  endforeach()
  file(REMOVE_RECURSE ${scratch})

  set(stamp ${A_DEST_ROOT}/headers.stamp)
  set(old_stamp "<none>")
  if(EXISTS ${stamp})
    file(READ ${stamp} old_stamp)
  endif()
  if(NOT old_stamp STREQUAL "${headers}")
    file(WRITE ${stamp} "${headers}")
  endif()
  list(LENGTH touched ntouched)
  message(STATUS "sms-3ds: ${count} ${name} patch(es) applied to ${ntouched} file(s)")
  set(${A_TOUCHED_VAR} ${touched} PARENT_SCOPE)
endfunction()

# Replace each list entry <SRC_ROOT>/<f> by <DEST_ROOT>/<f> for every touched f (same index).
function(sms_substitute_patched list_var src_root dest_root touched)
  set(lst ${${list_var}})
  foreach(f ${touched})
    list(FIND lst ${src_root}/${f} idx)
    if(NOT idx EQUAL -1)
      list(REMOVE_AT lst ${idx})
      list(INSERT lst ${idx} ${dest_root}/${f})
    endif()
  endforeach()
  set(${list_var} ${lst} PARENT_SCOPE)
endfunction()
