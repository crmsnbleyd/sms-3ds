 extern JPAEmitterManager* gpEmitterManager4D2;
 
+// The HUD's own particles (the counters' digit puffs, the water gauge's sparkles). The 3DS draws
+// the HUD on the bottom screen, so they go in their own emitter group, which EmitterViewObj.cpp
+// draws as HUD; the game's other 2D effects stay in group 0, on the top screen.
+#ifdef __3DS__
+static const u8 kHudEmitterGroup = 1;
+static bool createHudEmitter(JPAEmitterManager* manager, const JGeometry::TVec3<f32>& pos, s32 id,
+                             JPACallBackBase<JPABaseEmitter*>* cb,
+                             JPACallBackBase2<JPABaseEmitter*, JPABaseParticle*>* cb2)
+{
+	// as JPAEmitterManager::createEmitter, in the HUD's group
+	JPABaseEmitter* emitter = manager->createSimpleEmitterID(pos, id, kHudEmitterGroup, 0, cb, cb2);
+	if (!emitter)
+		return false;
+	manager->unkC4       = 1;
+	manager->unkC8[0][0] = emitter;
+	return true;
+}
+#else
+static inline bool createHudEmitter(JPAEmitterManager* manager, const JGeometry::TVec3<f32>& pos, s32 id,
+                                    JPACallBackBase<JPABaseEmitter*>* cb,
+                                    JPACallBackBase2<JPABaseEmitter*, JPABaseParticle*>* cb2)
+{
+	return manager->createEmitter(pos, id, cb, cb2);
+}
+#endif
