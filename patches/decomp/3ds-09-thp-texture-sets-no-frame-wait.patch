+#ifdef __3DS__
+void THPPlayerDrawDone()
+{
+	if (Initialized) {
+		unsigned int mark = sms3ds_gx_mark();
+		void* tex;
+		int i, n;
+		while ((tex = PopUsedTextureSet()) != NULL) {
+			if (sms3dsParked == 8) {  // never with the player's three sets
+				GXDrawDone();
+				PushFreeTextureSet(tex);
+				continue;
+			}
+			sms3dsParkedSet[sms3dsParked]  = tex;
+			sms3dsParkedMark[sms3dsParked] = mark;
+			sms3dsParked++;
+		}
+		for (i = 0, n = 0; i < sms3dsParked; i++) {
+			if (sms3ds_gx_reached(sms3dsParkedMark[i])) {
+				PushFreeTextureSet(sms3dsParkedSet[i]);
+			} else {
+				sms3dsParkedSet[n]  = sms3dsParkedSet[i];
+				sms3dsParkedMark[n] = sms3dsParkedMark[i];
+				n++;
+			}
+		}
+		sms3dsParked = n;
+	}
+}
