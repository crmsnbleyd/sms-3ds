+#ifdef __3DS__
+#include <System/ScenarioArchiveName.hpp>
+// Whether the scene an area loads is on the disc (as the warp menu's ApplicationWarpScene checks).
+// The stage table's areas 10-12 name developer scenes retail never loads (none, scale1, scale2,
+// test12): a warp there crashed in TGuide::load once the scene failed to load.
+static bool sms3dsWarpSceneExists(int stage, int scenario)
+{
+	TNameRefPtrAryT<TNameRefAryT<TScenarioArchiveName> >* stages = gpApplication.unk30;
+	if (!stages || stage >= (int)stages->getChildren().size())
+		return false;
+	TNameRefAryT<TScenarioArchiveName>* episodes = stages->getChildren()[stage];
+	if (!episodes || scenario < 0 || scenario >= (int)episodes->size())
+		return false;
+	const char* arc = episodes->getChildren()[scenario].mArcName;
+	if (!arc || !*arc)
+		return false;
+	char path[128];
+	snprintf(path, sizeof path, "/data/scene/%s", arc);
+	if (DVDConvertPathToEntrynum(path) >= 0)
+		return true;
+	char* ext = strstr(path, ".arc");
+	if (!ext)
+		return false;
+	strcpy(ext, ".szs");
+	return DVDConvertPathToEntrynum(path) >= 0;
 }
+#endif
