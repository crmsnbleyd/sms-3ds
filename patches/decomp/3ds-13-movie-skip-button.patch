+#ifdef __3DS__
+// The 3DS draws the prompt on the bottom screen (drawn as HUD: platform3ds/gx3ds/render.cpp shows
+// EFB x 0-640, y 0-448 there at half size, 8 rows down) as a large button, and a tap on it skips
+// the movie as A does (direct).
+extern "C" void GXPC_SetHud(int on);
+extern "C" int sms3ds_touch_tap(int* x, int* y);
+static JUTRect sms3dsSkipBox;  // the button, in EFB pixels
+static bool sms3dsMoviePrompt;  // SMSDrawSkipPrompt is drawing a movie's (not the logos') prompt
+
+static bool sms3dsSkipTapped()
+{
+	int x, y;
+	if (!sms3ds_touch_tap(&x, &y))
+		return false;
+	const int ex = x * 2, ey = y * 2 - 16, slack = 16;
+	return ex >= sms3dsSkipBox.x1 - slack && ex <= sms3dsSkipBox.x2 + slack && ey >= sms3dsSkipBox.y1 - slack
+	       && ey <= sms3dsSkipBox.y2 + slack;
+}
+#endif
