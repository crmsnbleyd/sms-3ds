+// The 3DS draws these message boxes (save, continue, "hear my explanation again?") on the bottom
+// screen, as HUD (platform3ds/gx3ds/render.cpp shows EFB x 0-640, y 0-448 there at half size, 8 rows
+// down) on a plain background, and a tap on a choice picks it as the stick and A do.
+extern "C" void GXPC_SetHud(int on);
+extern "C" void GXPC_BottomPlain(void);
+extern "C" int sms3ds_touch_tap(int* x, int* y);
+
+// A new tap on one of `n` choices (the nearest, within a margin): its index, else -1.
+static int sms3dsTappedChoice(J2DPane* const* panes, int n)
+{
+	int x, y;
+	if (!sms3ds_touch_tap(&x, &y))
+		return -1;
+	const int ex = x * 2, ey = y * 2 - 16, slack = 24;
+	int best = -1, bestDist = 0x7FFFFFFF;
+	for (int i = 0; i < n; i++) {
+		const JUTRect& r = panes[i]->getGlobalBounds();
+		if (ex < r.x1 - slack || ex > r.x2 + slack || ey < r.y1 - slack || ey > r.y2 + slack)
+			continue;
+		const int dx = ex - (r.x1 + r.x2) / 2, dy = ey - (r.y1 + r.y2) / 2;
+		const int dist = (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
+		if (dist < bestDist) {
+			bestDist = dist;
+			best     = i;
+		}
+	}
+	return best;
+}
+
+// After a choice prompt reads its input: a tapped choice, selected and confirmed (A).
+#define SMS3DS_TAP_CHOICE(input, ...)                                          \
+	do {                                                                       \
+		J2DPane* const sms3dsChoices[] = { __VA_ARGS__ };                      \
+		const int sms3dsTapped = sms3dsTappedChoice(                           \
+		    sms3dsChoices, sizeof sms3dsChoices / sizeof sms3dsChoices[0]);    \
+		if (sms3dsTapped >= 0) {                                               \
+			unk2E9 = (s8)sms3dsTapped;                                         \
+			input  = 0x20;                                                     \
+		}                                                                      \
+	} while (0)
 #endif
+#endif
 
