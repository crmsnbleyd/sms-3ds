+// What writeBP/CP/XF store (no side effects): the API's copy while the GX thread runs.
+static void shadowBP(uint32_t value) {
+    uint32_t reg = value >> 24, data = value & 0xFFFFFF;
+    if (reg == BP_MASK) {
+        GA.bpMask = data;
+        return;
+    }
+    if (GA.bpMask != 0xFFFFFF) {
+        data = (GA.bp[reg] & ~GA.bpMask) | (data & GA.bpMask);
+        GA.bpMask = 0xFFFFFF;
+    }
