+    case CP_MATIDX_B: GA.cpMatB = value; break;
+    case CP_VCD_LO: GA.cpVcdLo = value; break;
+    case CP_VCD_HI: GA.cpVcdHi = value; break;
+    case CP_VAT_A: GA.cpVatA[reg & 7] = value; break;
+    case CP_VAT_B: GA.cpVatB[reg & 7] = value; break;
+    case CP_VAT_C: GA.cpVatC[reg & 7] = value; break;
+    default: break;
